.DS_Store
# Из .claude/ в git только сервер макетов. !.claude/ — на случай, если .claude скрыта глобальным .gitignore
!.claude/
.claude/*
!.claude/launch.json

# Личный конфиг: email, репозитории, пути. В репозитории — config.example.json
config.json

# Генерирует install.sh с PATH этой машины; удаляет uninstall.sh
bin/

# Артефакты сборки и служебные папки
.build/
*.app/
.pr-review/
node_modules/
*.tmp
pr-reviewer-export-*.tar.gz

# Id сессий Claude — свои на каждой машине (agents/roles/README.md, «Сессии»)
agents/roles/sessions.local.md
