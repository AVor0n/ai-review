                    },
                    "title": {
                        "type": "string"
                    },
                    "details": {
                        "type": "string"
                    },
                    "path": {
                        "type": "string"
                    },
                    "line": {
                        "type": "integer"
                    }
                }
            }
        },
        "verdict": {
            "type": "string",
            "enum": [
                "keep",
                "discuss",
                "rework"
            ]
        },
        "summary": {
            "type": "string"
        },
        "questions": {
            "type": "array",
            "items": {
                "type": "string"
            }
