# Общее для заглушек: папка песочницы и журнал вызовов. Без QA_SANDBOX заглушка не работает — так её не запустить мимо песочницы
[ -n "$QA_SANDBOX" ] || { echo "qa: заглушка $0 вызвана без QA_SANDBOX" >&2; exit 1; }
qa_log() { echo "$(date +%T) $(basename "$0") $(echo "$*" | cut -c1-120)" >> "$QA_SANDBOX/stub.log"; }
